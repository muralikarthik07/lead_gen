[
 {
  "table": "Company",
  "pk": [
   "company_id"
  ],
  "description": "Master data: prospect organisations.",
  "lifecycle": "Created once; never deleted.",
  "columns": [
   {
    "name": "company_id",
    "type": "text",
    "required": true,
    "allowed": [],
    "unit": "",
    "unique": true,
    "rule": "CO-000001 sequence by created_at, immutable",
    "fk": "",
    "pattern": "^CO-\\d{6}$"
   },
   {
    "name": "company_name",
    "type": "text",
    "required": true,
    "allowed": [],
    "unit": "",
    "unique": true,
    "rule": "",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "domain",
    "type": "text",
    "required": true,
    "allowed": [],
    "unit": "",
    "unique": true,
    "rule": "reserved .example TLD: no real domains",
    "fk": "",
    "pattern": "^[a-z0-9]+\\.example$"
   },
   {
    "name": "industry",
    "type": "text",
    "required": true,
    "allowed": [
     "Software",
     "Financial Services",
     "Healthcare",
     "Manufacturing",
     "Retail",
     "Education",
     "Logistics",
     "Energy",
     "Media",
     "Public Sector"
    ],
    "unit": "",
    "unique": false,
    "rule": "",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "employee_count",
    "type": "integer",
    "required": true,
    "allowed": [],
    "unit": "employees",
    "unique": false,
    "rule": ">= 1",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "employee_band",
    "type": "text",
    "required": true,
    "allowed": [
     "1-10",
     "11-50",
     "51-200",
     "201-1000",
     "1000+"
    ],
    "unit": "",
    "unique": false,
    "rule": "derived: must equal band_of(employee_count)",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "annual_revenue_usd",
    "type": "real",
    "required": true,
    "allowed": [],
    "unit": "USD",
    "unique": false,
    "rule": "> 0; ~ employees x revenue/employee",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "country",
    "type": "text",
    "required": true,
    "allowed": [
     "US",
     "CA",
     "BR",
     "MX",
     "AR",
     "CL",
     "CO",
     "GB",
     "DE",
     "NL",
     "SE",
     "IE",
     "FR",
     "ES",
     "IT",
     "AE",
     "ZA",
     "PT",
     "AU",
     "SG",
     "JP",
     "IN"
    ],
    "unit": "ISO-3166 alpha-2",
    "unique": false,
    "rule": "",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "territory",
    "type": "text",
    "required": true,
    "allowed": [
     "NORAM",
     "LATAM",
     "EMEA-N",
     "EMEA-S",
     "APAC",
     "INDIA"
    ],
    "unit": "",
    "unique": false,
    "rule": "derived from country",
    "fk": "",
    "pattern": ""
   },
   {
    "name": "created_at",
    "type": "datetime",
    "required": true,
    "allowed": [],
    "unit": "UTC",
    "unique": false,
    "rule": "<= first contact created_at",
    "fk": "",
    "pattern": ""
   }
  ]
 },
